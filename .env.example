NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/scaniro

JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
OTP_HASH_SECRET=replace_with_another_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=90d
JWT_ISSUER=scaniro-api
JWT_AUDIENCE=scaniro-client

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-mailbox@example.com
SMTP_PASSWORD=replace_with_your_mailbox_app_password
SMTP_FROM=your-mailbox@example.com

AWS_ACCESS_KEY_ID=replace_with_storage_access_key
AWS_SECRET_ACCESS_KEY=replace_with_storage_secret_key
AWS_REGION=us-east-005
AWS_ENDPOINT=
AWS_S3_BUCKET=scaniro-app
