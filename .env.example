# Server Configuration
NODE_ENV=development
PORT=5001
CORS_ORIGIN=*

# MySQL Database Connection (Prisma)
# Replace 'root' and 'password' with your local MySQL credentials
DATABASE_URL="mysql://root:password@localhost:3306/scanpro_db"

# JWT Authentication Secrets
JWT_ACCESS_SECRET=scanpro_jwt_access_super_secret_key_2026
JWT_REFRESH_SECRET=scanpro_jwt_refresh_super_secret_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3 / MinIO Storage (Optional for cloud file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=scanpro-document-uploads
