datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum FilterType {
  ORIGINAL
  AUTO
  MAGIC_COLOR
  GRAYSCALE
  BLACK_AND_WHITE
}

enum UserLifecycleStatus {
  ACTIVE
  DELETING
}

enum DeletionStatus {
  PENDING
  RETRYING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum UploadGrantCleanupStatus {
  ACTIVE
  PENDING
  COMPLETED
  FAILED
}

enum AccountDeletionStatus {
  PENDING
  CLEANING
  FAILED
  COMPLETED
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  passwordHash      String              @map("password_hash")
  name              String
  lifecycleStatus   UserLifecycleStatus @default(ACTIVE) @map("lifecycle_status")
  deletionStartedAt DateTime?           @map("deletion_started_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  documents         Document[]
  folders           Folder[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token") @db.VarChar(500)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model Folder {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String     @db.VarChar(50)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  documents Document[]

  @@unique([userId, name])
  @@map("folders")
}

model Document {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId     String?        @map("folder_id")
  folder       Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title        String         @db.VarChar(255)
  thumbnailUrl String?        @map("thumbnail_url") @db.VarChar(500)
  pdfUrl       String?        @map("pdf_url") @db.VarChar(500)
  pageCount    Int            @default(1) @map("page_count")
  isFavorite   Boolean        @default(false) @map("is_favorite")
  syncStatus   SyncStatus     @default(SYNCED) @map("sync_status")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  pages        DocumentPage[]

  @@index([userId, isFavorite])
  @@index([userId, folderId])
  @@map("documents")
}

model DocumentPage {
  id           String     @id @default(uuid())
  documentId   String     @map("document_id")
  document     Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageOrder    Int        @map("page_order")
  imageUrl     String     @map("image_url") @db.VarChar(500)
  thumbnailUrl String?    @map("thumbnail_url") @db.VarChar(500)
  filter       FilterType @default(ORIGINAL)
  rotation     Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("document_pages")
}

// Deliberately has no FK to users/documents so the fence survives metadata deletion.
model DocumentTombstone {
  userId     String   @map("user_id") @db.VarChar(191)
  documentId String   @map("document_id") @db.VarChar(191)
  deletedAt  DateTime @default(now()) @map("deleted_at")

  @@id([userId, documentId])
  @@index([deletedAt])
  @@map("document_tombstones")
}

// Durable inventory of URLs issued by the API. No user FK: rows must survive account deletion.
model UploadGrant {
  id             String                  @id @default(uuid())
  userId         String                  @map("user_id") @db.VarChar(191)
  bucket         String                  @db.VarChar(100)
  objectKey      String                  @map("object_key") @db.VarChar(500)
  objectIdentity String                  @unique @map("object_identity") @db.Char(64)
  fileUrl        String                  @map("file_url") @db.VarChar(500)
  expiresAt      DateTime                @map("expires_at")
  cleanupDone    Boolean                 @default(false) @map("cleanup_done")
  cleanupState   UploadGrantCleanupStatus @default(ACTIVE) @map("cleanup_state")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@index([userId, cleanupDone])
  @@index([expiresAt, cleanupDone])
  @@map("upload_grants")
}

// Jobs have no FK to users so a completed deletion receipt remains queryable.
model AccountDeletionJob {
  id             String                @id @default(uuid())
  userId         String                @unique @map("user_id") @db.VarChar(191)
  status         AccountDeletionStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastError      String?               @map("last_error") @db.Text
  leaseToken     String?               @map("lease_token") @db.Char(36)
  leaseExpiresAt DateTime?             @map("lease_expires_at")
  startedAt      DateTime?             @map("started_at")
  completedAt    DateTime?             @map("completed_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@index([status, leaseExpiresAt, createdAt])
  @@map("account_deletion_jobs")
}

model PendingDeletion {
  id             String         @id @default(uuid())
  fileUrl        String?        @map("file_url") @db.VarChar(500)
  bucket         String?        @db.VarChar(100)
  objectKey      String?        @map("object_key") @db.VarChar(500)
  objectIdentity String?        @unique @map("object_identity") @db.Char(64)
  documentId     String?        @map("document_id")
  userId         String         @map("user_id") @db.VarChar(191)
  attempts       Int            @default(0)
  lastError      String?        @map("last_error") @db.Text
  status         DeletionStatus @default(PENDING)
  notBefore      DateTime?      @map("not_before")
  leaseToken     String?        @map("lease_token") @db.Char(36)
  leaseExpiresAt DateTime?      @map("lease_expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([status, leaseExpiresAt, createdAt])
  @@index([userId, status])
  @@map("pending_deletions")
}
