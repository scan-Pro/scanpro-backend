NODE_ENV=development
PORT=5001
CORS_ORIGIN=*

# Update with your MySQL username, password, host, port, and db name:
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/scanpro_db"

JWT_ACCESS_SECRET=scanpro_jwt_access_super_secret_key_2026
