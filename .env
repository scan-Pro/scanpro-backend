NODE_ENV=development
PORT=5001

# MySQL connection string
DATABASE_URL="mysql://root:@localhost:3306/scanpro_db"

# JWT Secrets
JWT_ACCESS_SECRET="scanpro_jwt_access_super_secret_key_2026_change_in_production"
JWT_REFRESH_SECRET="scanpro_jwt_refresh_super_secret_key_2026_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3 (Presigned URLs for uploads)
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="scanpro-document-uploads"

# CORS
CORS_ORIGIN="*"